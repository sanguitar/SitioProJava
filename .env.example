SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083
SERVER_FORWARD_HEADERS_STRATEGY=native
SESSION_COOKIE_SECURE=false
NGINX_HTTP_PORT=80

DB_HOST=localhost
DB_PORT=1433
DB_NAME=sitio_db
DB_USERNAME=sitiopro_app
DB_PASSWORD=Change_me_with_a_strong_app_password
FLYWAY_USERNAME=sitiopro_migration
FLYWAY_PASSWORD=Change_me_with_a_strong_migration_password
MSSQL_SA_PASSWORD=Change_me_with_a_strong_sa_password

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

MSSQL_PID=Developer
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

SITIOPRO_INITIAL_ADMIN_ENABLED=false
SITIOPRO_INITIAL_ADMIN_LOGIN=admin_local
SITIOPRO_INITIAL_ADMIN_PASSWORD=Change_me_with_a_strong_initial_admin_password
SITIOPRO_INITIAL_ADMIN_NAME=Administrador Local

# Integrações externas (coordenadas fictícias; substitua somente no .env local)
SITIOPRO_INTEGRATIONS_ZONE=Etc/UTC
SITIOPRO_OPEN_METEO_ENABLED=false
OPEN_METEO_BASE_URL=https://api.open-meteo.com
SITIO_LATITUDE=-00.000000
SITIO_LONGITUDE=-00.000000
SITIO_TIMEZONE=Etc/UTC
SITIOPRO_CLIMATE_CONTEXT=principal
OPEN_METEO_CRON=0 17 */3 * * *
OPEN_METEO_CONNECT_TIMEOUT=3s
OPEN_METEO_READ_TIMEOUT=8s
OPEN_METEO_STALE_AFTER=6h
OPEN_METEO_FORECAST_DAYS=7
OPEN_METEO_RETENTION_DAYS=30

SITIOPRO_EMBRAPA_AGROFIT_ENABLED=false
EMBRAPA_AGROFIT_BASE_URL=https://api.cnptia.embrapa.br/agrofit/v1
EMBRAPA_AGROFIT_TOKEN=replace_with_official_agroapi_token
EMBRAPA_AGROFIT_CRON=0 29 3 * * MON
EMBRAPA_AGROFIT_CONNECT_TIMEOUT=3s
EMBRAPA_AGROFIT_READ_TIMEOUT=10s
EMBRAPA_AGROFIT_STALE_AFTER=9d
EMBRAPA_AGROFIT_MAX_PAGES=1

# Observabilidade opcional
SITIOPRO_ENVIRONMENT=dev
SITIOPRO_APP_VERSION=0.0.1-SNAPSHOT
SITIOPRO_OBSERVABILITY_ENABLED=false
SITIOPRO_OBSERVABILITY_APM_SERVER_URL=http://apm-server:8200
SITIOPRO_LOG_FILE=/tmp/sitiopro/app.ecs.json
SITIOPRO_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BIND_LOG_LEVEL=WARN

ELASTIC_STACK_VERSION=9.5.0
ELASTIC_APM_AGENT_VERSION=1.56.0
ELASTIC_APM_ENABLED=true
ELASTIC_PASSWORD=Change_me_with_a_strong_elastic_password
KIBANA_SYSTEM_PASSWORD=Change_me_with_a_strong_kibana_system_password
KIBANA_DEV_ADMIN_LOGIN=local_kibana_admin
KIBANA_DEV_ADMIN_PASSWORD=Change_me_with_a_strong_kibana_admin_password
ELASTIC_APM_SECRET_TOKEN=Change_me_with_a_strong_apm_secret_token
KIBANA_ENCRYPTION_KEY=Change_me_with_at_least_32_characters_key
KIBANA_PORT=5601

ELASTICSEARCH_HEAP=1g
ELASTICSEARCH_MEM_LIMIT=1536m
KIBANA_MEM_LIMIT=1g
APM_SERVER_MEM_LIMIT=256m
ELASTIC_AGENT_MEM_LIMIT=512m
