SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083
SERVER_FORWARD_HEADERS_STRATEGY=native
SESSION_COOKIE_SECURE=false
NGINX_HTTP_PORT=80

DB_HOST=localhost
DB_PORT=1433
DB_NAME=sitio_db
DB_USERNAME=sitiopro_app
DB_PASSWORD=Change_me_with_a_strong_app_password
FLYWAY_USERNAME=sitiopro_migration
FLYWAY_PASSWORD=Change_me_with_a_strong_migration_password
MSSQL_SA_PASSWORD=Change_me_with_a_strong_sa_password

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

MSSQL_PID=Developer
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

SITIOPRO_INITIAL_ADMIN_ENABLED=false
SITIOPRO_INITIAL_ADMIN_LOGIN=admin_local
SITIOPRO_INITIAL_ADMIN_PASSWORD=Change_me_with_a_strong_initial_admin_password
SITIOPRO_INITIAL_ADMIN_NAME=Administrador Local

# Observabilidade opcional
SITIOPRO_ENVIRONMENT=dev
SITIOPRO_APP_VERSION=0.0.1-SNAPSHOT
SITIOPRO_OBSERVABILITY_ENABLED=false
SITIOPRO_OBSERVABILITY_APM_SERVER_URL=http://apm-server:8200
SITIOPRO_LOG_FILE=/tmp/sitiopro/app.ecs.json
SITIOPRO_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=WARN
HIBERNATE_BIND_LOG_LEVEL=WARN

ELASTIC_STACK_VERSION=9.5.0
ELASTIC_APM_AGENT_VERSION=1.56.0
ELASTIC_APM_ENABLED=true
ELASTIC_PASSWORD=Change_me_with_a_strong_elastic_password
KIBANA_SYSTEM_PASSWORD=Change_me_with_a_strong_kibana_system_password
ELASTIC_APM_SECRET_TOKEN=Change_me_with_a_strong_apm_secret_token
KIBANA_ENCRYPTION_KEY=Change_me_with_at_least_32_characters_key
KIBANA_PORT=5601

ELASTICSEARCH_HEAP=1g
ELASTICSEARCH_MEM_LIMIT=1536m
KIBANA_MEM_LIMIT=1g
APM_SERVER_MEM_LIMIT=256m
ELASTIC_AGENT_MEM_LIMIT=512m
