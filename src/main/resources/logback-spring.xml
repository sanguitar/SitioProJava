<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="SERVICE_NAME" source="sitiopro.observability.service-name" defaultValue="sitioguaratingueta"/>
    <springProperty scope="context" name="SERVICE_ENVIRONMENT" source="sitiopro.observability.environment" defaultValue="dev"/>
    <springProperty scope="context" name="SERVICE_VERSION" source="info.app.version" defaultValue="0.0.1-SNAPSHOT"/>

    <property name="SITIOPRO_LOG_FILE" value="${SITIOPRO_LOG_FILE:-${java.io.tmpdir}/sitiopro/app.ecs.json}"/>
    <property name="SITIOPRO_LOG_LEVEL" value="${SITIOPRO_LOG_LEVEL:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>${SERVICE_NAME}</serviceName>
            <serviceVersion>${SERVICE_VERSION}</serviceVersion>
            <serviceEnvironment>${SERVICE_ENVIRONMENT}</serviceEnvironment>
            <eventDataset>${SERVICE_NAME}.app</eventDataset>
            <includeOrigin>false</includeOrigin>
            <stackTraceAsArray>true</stackTraceAsArray>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${SITIOPRO_LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${SITIOPRO_LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>${SITIOPRO_LOG_MAX_FILE_SIZE:-10MB}</maxFileSize>
            <maxHistory>${SITIOPRO_LOG_MAX_HISTORY:-7}</maxHistory>
            <totalSizeCap>${SITIOPRO_LOG_TOTAL_SIZE_CAP:-256MB}</totalSizeCap>
        </rollingPolicy>
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>${SERVICE_NAME}</serviceName>
            <serviceVersion>${SERVICE_VERSION}</serviceVersion>
            <serviceEnvironment>${SERVICE_ENVIRONMENT}</serviceEnvironment>
            <eventDataset>${SERVICE_NAME}.app</eventDataset>
            <includeOrigin>false</includeOrigin>
            <stackTraceAsArray>true</stackTraceAsArray>
        </encoder>
    </appender>

    <logger name="org.hibernate.SQL" level="${HIBERNATE_SQL_LOG_LEVEL:-WARN}"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="${HIBERNATE_BIND_LOG_LEVEL:-WARN}"/>
    <logger name="com.example.sitiopro.shared.observability.RequestObservabilityFilter" level="INFO"/>
    <logger name="com.example.sitiopro.usuario.security.SecurityEventLogger" level="INFO"/>

    <root level="${SITIOPRO_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
